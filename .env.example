# Local Web access and container-to-container MCP authentication.
MCP_AUTH_TOKEN=
# Tunnel associated with your Platform organization and ChatGPT workspace.
CONTROL_PLANE_TUNNEL_ID=
# Tunnel runtime API key with Tunnels Read + Use; never an admin key.
CONTROL_PLANE_API_KEY=
# Optional: Host headers the service accepts. Add the public reverse-proxy
# hostname when a Claude connector vhost fronts this service.
# ALLOWED_HOSTS=tarot-mcp,localhost,127.0.0.1,tarot.example.com
