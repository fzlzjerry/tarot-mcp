{
  "name": "tarot-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server and visual app for bilingual tarot readings",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:server && npm run build:ui && node scripts/copy-assets.mjs",
    "build:server": "tsc",
    "build:ui": "npm run typecheck:ui && npm run build:ui:web && npm run build:ui:mcp",
    "build:ui:web": "vite build --config ui/vite.web.config.ts",
    "build:ui:mcp": "vite build --config ui/vite.mcp.config.ts",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport http --port 3000",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http --port 3000",
    "test": "vitest run",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "test:all": "npm run test && npm run test:ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"ui/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.ts\" \"ui/src/**/*.{ts,tsx,css}\"",
    "verify:assets": "node scripts/art/validate-deck.mjs",
    "verify:build": "npm run verify:assets && node scripts/verify-build-assets.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run verify:build",
    "docker:build": "docker build -t tarot-mcp .",
    "docker:run": "docker run -p 3000:3000 tarot-mcp",
    "docker:compose": "docker compose up -d"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tarot",
    "visual-tarot",
    "divination",
    "ai"
  ],
  "author": "Morax",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "express-rate-limit": "^8.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "bin": {
    "tarot-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/**/*",
    "docs/**/*.md",
    "README.md",
    "SPEC.md",
    "DESIGN.md",
    "PRODUCT.md",
    "assets/ASSET_LICENSE.md",
    "scripts/art/README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.moraxcheng.me/Morax/tarot-mcp.git"
  },
  "bugs": {
    "url": "https://git.moraxcheng.me/Morax/tarot-mcp/issues"
  },
  "homepage": "https://git.moraxcheng.me/Morax/tarot-mcp#readme"
}
