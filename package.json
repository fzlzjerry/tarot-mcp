{
  "name": "tarot-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Rider-Waite tarot card readings",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/copy-assets.mjs",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --transport http --port 3000",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && node scripts/verify-build-assets.mjs",
    "docker:build": "docker build -t tarot-mcp .",
    "docker:run": "docker run -p 3000:3000 tarot-mcp",
    "docker:compose": "docker compose up -d"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tarot",
    "rider-waite",
    "divination",
    "ai"
  ],
  "author": "Morax",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "express-rate-limit": "^8.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "bin": {
    "tarot-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.moraxcheng.me/Morax/tarot-mcp.git"
  },
  "bugs": {
    "url": "https://git.moraxcheng.me/Morax/tarot-mcp/issues"
  },
  "homepage": "https://git.moraxcheng.me/Morax/tarot-mcp#readme"
}
